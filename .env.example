# Default configuration is a loopback-only demonstration.
ASTROTWIN_MODE=demo
ASTROTWIN_HTTP_PORT=5173
ASTROTWIN_API_PORT=8000
ASTROTWIN_WORKERS=2
# Auto-populate the demo with simulated vitals. Set false when testing a real source.
ASTROTWIN_DEMO_TELEMETRY=true

POSTGRES_DB=medical_inventory
POSTGRES_USER=astronaut
POSTGRES_PASSWORD=deepspacepassword
# Optional managed PostgreSQL connection URL. Otherwise Compose uses its private database.
DATABASE_URL=

# Optional inline keys for a direct backend run. Prefer file-backed secrets with the production overlay.
ASTROTWIN_OPERATOR_KEY=
ASTROTWIN_TELEMETRY_KEY=
ASTROTWIN_VIEWER_KEY=

# The production overlay requires these paths to production-only files containing one secret each.
ASTROTWIN_OPERATOR_KEY_HOST_FILE=
ASTROTWIN_TELEMETRY_KEY_HOST_FILE=
ASTROTWIN_VIEWER_KEY_HOST_FILE=
POSTGRES_PASSWORD_HOST_FILE=

# The default is enabled for demo mode and disabled for production.
ASTROTWIN_SEED_INVENTORY=
ASTROTWIN_NASA_API_KEY=
ASTROTWIN_TELEMETRY_STALE_SECONDS=30
# Leave empty for the same-origin Docker gateway.
ASTROTWIN_CORS_ORIGINS=
